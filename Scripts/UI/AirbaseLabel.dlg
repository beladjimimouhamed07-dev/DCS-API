		["text"] = "New dialog",
		["unitTest"] = "local percentInfos = {\
    {percent = 75    , angle = 270    , widget = 'staticPercent75'},\
    {percent = 50    , angle = 180    , widget = 'staticPercent50'},\
    {percent = 25    , angle = 90    , widget = 'staticPercent25'},\
    {percent = 12.5    , angle = 45    , widget = 'staticPercent13'},\
    {percent = 6.25    , angle = 22.5    , widget = 'staticPercent7'    },\
    {percent = 3.125    , angle = 11.25    , widget = 'staticPercent4'    },\
    {percent = 1.5625    , angle = 5.625        , widget = 'staticPercent2'    },\
}\
\
local function processValue(value)\
    print('~~~processValue', value)\
    \
    local extraAngle = 0\
    local result = {}\
    local valueCopy = value\
    \
    for i, info in ipairs(percentInfos) do\
        if valueCopy - info.percent >= 0 then\
            table.insert(result, {widget = info.widget, visible = true, angle = extraAngle})\
            print('~~~', info.widget, extraAngle)            \
            extraAngle = extraAngle + info.angle\
            valueCopy = valueCopy - info.percent\
        else\
            table.insert(result, {widget = info.widget, visible = false, angle = 0})\
        end\
    end\
    \
    if value > 0 and value < 100 then\
        table.insert(result, {widget = 'staticPercentBegin', visible = true, angle = 0})\
        table.insert(result, {widget = 'staticPercentEnd', visible = true, angle = extraAngle})\
        table.insert(result, {widget = 'staticProgressBkg', visible = true, angle = 0})\
    else\
        table.insert(result, {widget = 'staticPercentBegin', visible = false, angle = 0})\
        table.insert(result, {widget = 'staticPercentEnd', visible = false, angle = 0})        \
        table.insert(result, {widget = 'staticProgressBkg', visible = false, angle = 0})        \
    end    \
\
    return result\
end\
\
local panels = {\
    dialog.panelCircleBlue,\
    --dialog.panelCircleRed,\
}\
\
function dialog.horzSliderPercent:onChange()\
    local value = dialog.horzSliderPercent:getValue()\
    local infos = processValue(value)\
    \
    for j, panel in ipairs(panels) do\
        for i, info in ipairs(infos) do\
            \
            local widget = panel[info.widget]\
            \
            widget:setVisible(info.visible)\
            \
            if info.visible then\
                widget:setAngle(-info.angle)\
            end\
        end\
        \
        panel.staticPercentText:setText(dialog.horzSliderPercent:getValue())\
    end\
\
    dialog.panelCircleBlue:redraw()\
end\
\
dialog.panelCircleBlue:setOpacity(0.7)",
