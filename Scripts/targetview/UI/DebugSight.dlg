		["text"] = "New dialog",
		["unitTest"] = "package.loaded['DebugSight'] = nil -- for reloading changes in DebugSight\
local DebugSight    = require('DebugSight')\
local dxgui            = require('dxgui')\
\
DebugSight.create(dialog)\
DebugSight.setShellText('Default shell')\
DebugSight.setDistanceText('1234 m')\
DebugSight.setDistanceWidgetPosition(300, 300)\
\
DebugSight.show()\
\
local sw, sh    = dxgui.GetScreenSize()\
local cx        = sw / 2\
local cy        = sh / 2\
local radius    = 300\
local angle        = 0\
\
DebugSight.setCrossPosition(cx, cy)\
\
function activity()\
    local x = cx + math.sin(angle) * radius\
    local y = cy + math.cos(angle) * radius\
    \
    DebugSight.setCrossPosition(x, y)\
    angle = angle + math.pi / 15\
\
	DebugSight.setShellText('Default shell')\
    DebugSight.setDistanceText('x:' .. x .. '\\ny:' .. y)\
end",
